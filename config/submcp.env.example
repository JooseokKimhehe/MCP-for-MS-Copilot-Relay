# SubMCP settings (example)
# Choose either SUB_MCP_REGISTRY (multi) or SUB_MCP_BASE_URL + SUB_MCP_NAME (single)

# Example (multi):
# SUB_MCP_REGISTRY=[{"name":"internal","base_url":"http://10.0.0.5:9001"},{"name":"sec","base_url":"http://10.0.0.6:9002"}]

# Example (single):
# SUB_MCP_BASE_URL=http://10.0.0.5:9001
# SUB_MCP_NAME=internal

# Optional timeout (seconds)
# SUB_MCP_TIMEOUT=10

# Gateway auth (Copilot -> Gateway)
# MCP_API_KEY=replace-with-your-api-key
